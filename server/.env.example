SESSION_SECRET=replace-with-a-long-random-string
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database — free Postgres from neon.tech (SQLite file was removed because it
# doesn't survive redeploys on hosts like Render's free tier). Create a free
# project at neon.tech, copy its connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Image uploads — free object storage from Cloudflare R2 (dash.cloudflare.com
# → R2). Create a bucket, an API token with R2 read/write access, and enable
# the bucket's "Public Development URL" (or a custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=inkmap-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Optional: real email delivery. Without these, InkMap automatically uses a
# free Ethereal test inbox and logs a preview link for every email instead —
# fine for development, but emails never reach a real mailbox.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# MAIL_FROM="InkMap" <no-reply@yourdomain.dk>
